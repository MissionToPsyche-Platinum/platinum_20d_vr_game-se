  handoffChime: {fileID: 8300000, guid: d14b106713a74b448bcab90869f1706e, type: 3}
  marsFlyby:
    title: Mars Flyby
    banner: 
    footer: Mars' gravity bent Psyche's path and flung it toward the asteroid belt.
    mainPhotos:
    - sprite: {fileID: 21300000, guid: bb8807ddd71afff68af6bf2886d1c177, type: 3}
      caption: 'Psyche''s route: launch 2023, Mars 2026, the asteroid 2029.'
      credit: NASA/JPL-Caltech
    topPhotos:
    - sprite: {fileID: 21300000, guid: 7932a96443413aa01bde896a92a911ac, type: 3}
      caption: "Mars' crescent grew as Psyche closed in, May 2\u201315."
      credit: NASA/JPL-Caltech/ASU
    - sprite: {fileID: 21300000, guid: b11fca13276e86ff898b434dd7391298, type: 3}
      caption: Dusty air made the crescent glow brighter than expected.
      credit: NASA/JPL-Caltech/ASU
    - sprite: {fileID: 21300000, guid: 76e900d5743201f41beb08e2ad9a6086, type: 3}
      caption: Craters, ridges and wind streaks, shot in 6 minutes.
      credit: NASA/JPL-Caltech/ASU
    - sprite: {fileID: 21300000, guid: e451360d652edf239baafbd9db517a94, type: 3}
      caption: Mars' south polar ice cap, just after closest approach.
      credit: NASA/JPL-Caltech/ASU
    - sprite: {fileID: 21300000, guid: 2a0b6a1829d149c5b9c9c1c385c676d4, type: 3}
      caption: Huygens crater, seen in enhanced color.
      credit: NASA/JPL-Caltech/ASU
    - sprite: {fileID: 21300000, guid: b6f835fd589b0b7639b37361398f8039, type: 3}
      caption: Leaving Mars behind, headed for the asteroid belt.
      credit: NASA/JPL-Caltech/ASU
    bottomPhotos: []
    stats:
    - value: 2,864 mi
      label: from Mars' surface
    - value: +1,000 mph
      label: speed boost
    - value: 0 kg
      label: fuel for the boost
  deepSpaceNetwork:
    title: Deep Space Network
    banner: "Goldstone, California \xB7 Madrid, Spain \xB7 Canberra, Australia: three
      Deep Space Communications Complexes about 120\xB0 apart, so as Earth turns,
      one always faces Psyche."
    footer: A radio signal to Psyche and back takes {RT} minutes.
    mainPhotos:
    - sprite: {fileID: 21300000, guid: 066707e2a9ec61cbf9079c5e316c9a27, type: 3}
      caption: Big dishes on Earth talk to Psyche's 2 m antenna by radio.
      credit: NASA/JPL-Caltech
    topPhotos:
    - sprite: {fileID: 21300000, guid: 0a266388c51b143928584b30bcbebc62, type: 3}
      caption: How handoffs work
      credit: 
    bottomPhotos:
    - sprite: {fileID: 21300000, guid: 681669bb4ad98a282a2696bf6e8a5b6a, type: 3}
      caption: A 34-meter dish, the size Psyche usually uses.
      credit: NASA/JPL-Caltech
    stats: []
  solarPower:
    title: Solar Power
    banner: 
    footer: 'At the asteroid, about 2.3 kW: a little more than a hair dryer.'
    mainPhotos: []
    topPhotos:
    - sprite: {fileID: 21300000, guid: 4d34f29bcbc02692487760a4dbcb4687, type: 3}
      caption: One of Psyche's two solar array wings, unfolded for testing.
      credit: NASA/JPL-Caltech
    bottomPhotos:
    - sprite: {fileID: 21300000, guid: 8b8c169037089685cb6aaf0b6e3c8fb7, type: 3}
      caption: Solar cells up close.
      credit: NASA/JPL-Caltech
    stats:
    - value: 21 kW
      label: near Earth
    - value: ~2.3 kW
      label: at the asteroid's farthest point
  thruster:
    title: Thruster
    banner: 
    footer: Grab the mouse to feel Psyche's push.
    mainPhotos:
    - sprite: {fileID: 21300000, guid: af5d023a8c5c3fe0da11e831baac50c1, type: 3}
      caption: 'A Hall-effect thruster firing: the blue glow is xenon.'
      credit: NASA/JPL-Caltech
    topPhotos:
    - sprite: {fileID: 21300000, guid: 05d77cfdc2a1fa5de85cc4b7aad09e74, type: 3}
      caption: Psyche has four thrusters; only one fires at a time.
      credit: NASA/JPL-Caltech
    bottomPhotos: []
    stats:
    - value: ~250 mN
      label: about an AA battery resting on your palm
    - value: 1 of 4
      label: thrusters fire at a time
    - value: "0.35\u20131.3 kg"
      label: of xenon a day
  spacecraftIcon: {fileID: 21300000, guid: 0dea3dd17673683808a29b42fe8055d5, type: 3}
  pushLines:
  - Grab the mouse to feel Psyche's push.
  - That's it. That's the whole push.
  - 'Psyche keeps it up for weeks at a time: enough to cross the solar system.'
  attractPrompt: Slap ENTER
